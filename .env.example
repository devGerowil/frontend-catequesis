# Configuración de Supabase para la app.
# Copia este archivo como `.env` y rellena los valores.
# Las encuentras en: Supabase Dashboard → tu proyecto → Project Settings → API
#
# IMPORTANTE: aquí solo va la clave "anon / public". Nunca la "service_role",
# porque esa le daría control total de la base de datos a cualquiera que abra la web.

VITE_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...pega-aqui-la-clave-anon...
